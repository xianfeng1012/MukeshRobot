# ============ Bot Tokens ============
# 从BotFather获取的三个bot token
GROUP_BOT_TOKEN=your_group_bot_token_here
MINIAPP_BOT_TOKEN=your_miniapp_bot_token_here
USER_BOT_TOKEN=your_user_bot_token_here

# ============ API配置 ============
API_BOT_TOKEN=your_api_bot_token_here
SHARED_API_URL=http://localhost:5000/api

# ============ 数据库 ============
MONGO_URI=mongodb://localhost:27017
MONGO_DB=telegram_bot_db
REDIS_URL=redis://localhost:6379/0

# ============ Mini App配置 ============
MINIAPP_URL=https://miniapp.example.com
MINIAPP_SECRET=your_miniapp_secret_key_here
MINIAPP_WEBHOOK_URL=http://localhost:8000/webhook/mini-app-event

# ============ JWT配置 ============
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# ============ 其他配置 ============
LOG_LEVEL=INFO
API_DEBUG=False
BOT_USERNAME=your_group_bot_username
