# ============ Bot Tokens ============
# 从BotFather获取的三个bot token
GROUP_BOT_TOKEN=your_group_bot_token_here
MINIAPP_BOT_TOKEN=your_miniapp_bot_token_here
USER_BOT_TOKEN=your_user_bot_token_here

# ============ 双向客服机器人（多号共群）============
# 逗号分隔的对外机器人 token 列表；后期加号往这里追加并把新号拉进客服群
DUAL_BOT_TOKENS=token1,token2,token3
# 客服群 ID（所有 dual bot 都要拉进这个群）
SUPPORT_GROUP_ID=-1001234567890

# ============ 关注频道验证（群管理机器人）============
# 新人进群需关注此频道才能解禁；group_bot 必须是该频道管理员
VERIFY_CHANNEL_ID=-1001234567890
VERIFY_CHANNEL_LINK=https://t.me/+xxxxxxxx
VERIFY_CHANNEL_NAME=公示榜

# ============ API配置 ============
API_BOT_TOKEN=your_api_bot_token_here
SHARED_API_URL=http://localhost:5000/api

# ============ 数据库 ============
MONGO_URI=mongodb://localhost:27017
MONGO_DB=telegram_bot_db
REDIS_URL=redis://localhost:6379/0

# ============ Mini App配置 ============
MINIAPP_URL=https://miniapp.example.com
MINIAPP_SECRET=your_miniapp_secret_key_here
MINIAPP_WEBHOOK_URL=http://localhost:8000/webhook/mini-app-event

# ============ JWT配置 ============
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# ============ 其他配置 ============
LOG_LEVEL=INFO
API_DEBUG=False
BOT_USERNAME=your_group_bot_username
